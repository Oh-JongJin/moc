---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@fontsource/gowun-batang/400.css';
import '@fontsource/gowun-batang/700.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '../styles/global.css';
import mainPhoto from '../assets/main.png';
import { config } from '../config';

const { groom, bride, venue, date, accounts, share } = config;

// ----- 날짜 표기 -----
const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];
const weekday = new Date(Date.UTC(date.year, date.month - 1, date.day)).getUTCDay();
const pad = (n: number) => String(n).padStart(2, '0');
const hourLabel =
  date.hour === 12 ? '낮 12시' : date.hour < 12 ? `오전 ${date.hour}시` : `오후 ${date.hour - 12}시`;
const timeLabel = date.minute ? `${hourLabel} ${date.minute}분` : hourLabel;
const dateLabel = `${date.year}년 ${date.month}월 ${date.day}일 ${WEEKDAYS[weekday]}요일`;
const dateDots = `${date.year}. ${pad(date.month)}. ${pad(date.day)}`;
const isoDate = `${date.year}-${pad(date.month)}-${pad(date.day)}`;

// ----- 달력 -----
const firstWeekday = new Date(Date.UTC(date.year, date.month - 1, 1)).getUTCDay();
const daysInMonth = new Date(Date.UTC(date.year, date.month, 0)).getUTCDate();
const calendarCells: (number | null)[] = [
  ...Array(firstWeekday).fill(null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];

// ----- 지도 링크 -----
const q = encodeURIComponent(venue.mapQuery);
const mapLinks: { label: string; href: string; app?: string }[] = [
  // 세 버튼 모두 예식장이 도착지로 지정된 길찾기 화면을 엽니다
  { label: '네이버지도', href: venue.naverDirections || `https://map.naver.com/p/search/${q}` },
  { label: '카카오맵', href: `https://map.kakao.com/link/to/${encodeURIComponent(venue.name)},${venue.lat},${venue.lng}` },
  // 티맵은 앱 전용 주소라서 새 창이 아닌 현재 창에서 열고, 앱이 없으면 설치 화면으로 안내합니다 (main.ts)
  {
    label: '티맵',
    href: `tmap://route?goalname=${encodeURIComponent(venue.name)}&goalx=${venue.lng}&goaly=${venue.lat}`,
    app: 'tmap',
  },
];

// ----- 갤러리: src/assets/gallery 폴더에 사진을 넣으면 파일 이름순으로 자동 표시 -----
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);
const galleryFiles = Object.keys(galleryModules)
  .sort()
  .map((key) => galleryModules[key].default);
// 처음에는 이만큼만 보여 주고, 나머지는 '사진 더 보기'를 누르면 펼쳐집니다
const GALLERY_PREVIEW = 9;
const galleryFull = await Promise.all(
  galleryFiles.map((src) => getImage({ src, width: Math.min(src.width, 1200), format: 'webp' })),
);

// ----- 카톡 미리보기 이미지 -----
const ogImage = await getImage({
  src: mainPhoto,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 82,
});
const ogImageUrl = new URL(ogImage.src, config.siteUrl).href;

const telHref = (phone: string) => `tel:${phone.replace(/[^0-9+]/g, '')}`;
const smsHref = (phone: string) => `sms:${phone.replace(/[^0-9+]/g, '')}`;

const accountGroups = [
  { label: '신랑측 계좌번호', list: accounts.groom },
  { label: '신부측 계좌번호', list: accounts.bride },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#3f5384" />
    <meta name="format-detection" content="telephone=no" />
    <title>{share.title}</title>
    <meta name="description" content={share.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={config.siteUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <script is:inline>
      (function () {
        var html = document.documentElement;
        // pre: 화면 크기가 자리 잡고 메인 사진이 준비될 때까지 내용을 숨겨 둡니다.
        // 카카오톡 브라우저는 페이지가 밀려 들어오는 동안 화면을 더 크게 잡았다가 줄이기 때문에,
        // 바로 보여 주면 사진이 크게 나왔다가 뚝 줄어드는 것처럼 보입니다.
        html.classList.add('js', 'pre');

        // 첫 방문 때만 인트로를 재생합니다. 주소 끝에 ?intro 를 붙이면 다시 볼 수 있습니다.
        var seen = false;
        try {
          seen = !!sessionStorage.getItem('intro-seen');
        } catch (e) {}
        var force = location.search.indexOf('intro') > -1;
        var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var play = force || (!seen && !reduce);
        if (play) html.setAttribute('data-intro', '1');

        var started = Date.now();
        var lastResize = started;
        window.addEventListener('resize', function () {
          lastResize = Date.now();
        });

        function ready() {
          var now = Date.now();
          var elapsed = now - started;
          if (elapsed > 2500) return true; // 어떤 경우에도 2.5초 넘게 숨기지 않습니다
          var img = document.querySelector('.hero-photo');
          if (!img || !img.complete || !img.naturalWidth) return false;
          if (elapsed < 600 || now - lastResize < 250) return false;
          // 화면보다 큰 창 높이는 아직 자리 잡기 전이라는 뜻입니다
          if (window.screen && screen.height && window.innerHeight > screen.height) return false;
          return true;
        }

        (function tick() {
          if (!ready()) return setTimeout(tick, 50);
          html.classList.remove('pre');
          if (play) {
            html.classList.add('intro');
            document.dispatchEvent(new Event('intro-start'));
          }
        })();
      })();
    </script>
  </head>
  <body>
    <main class="card">
      <!-- 메인 -->
      <header class="hero">
        <Image
          class="hero-photo"
          src={mainPhoto}
          alt="노을 지는 바다를 함께 바라보는 신랑 신부의 뒷모습"
          widths={[480, 860, 1290]}
          sizes="(min-width: 430px) 430px, 100vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
        <!-- 인트로: 실제 사진 위에 해와 빛을 겹쳐, 해가 수평선 아래로 지는 장면을 만듭니다 -->
        <div class="intro-daylight" aria-hidden="true"></div>
        <div class="intro-halo" aria-hidden="true"></div>
        <div class="intro-glitter" aria-hidden="true"></div>
        <div class="intro-sunclip" aria-hidden="true"><div class="intro-sun"></div></div>
        <div class="hero-top">
          <p class="latin hero-label">We are getting married</p>
          <h1 class="hero-names" aria-label={`${groom.name} 그리고 ${bride.name}`}>
            <span aria-hidden="true">
              {[...groom.name].map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
            </span>
            <span class="hero-amp latin ch" style={`--i:${[...groom.name].length}`} aria-hidden="true">and</span>
            <span aria-hidden="true">
              {[...bride.name].map((ch, i) => <span class="ch" style={`--i:${[...groom.name].length + 1 + i}`}>{ch}</span>)}
            </span>
          </h1>
        </div>
        <div class="hero-bottom">
          <p class="hero-date latin">{dateDots}</p>
          <p class="hero-place">{WEEKDAYS[weekday]}요일 {timeLabel} · {venue.name}</p>
        </div>
      </header>

      <!-- 인사말 (밤바다) -->
      <section class="night">
        <div class="reveal">
          <p class="latin eyebrow">Invitation</p>
          <h2 class="title">소중한 분들을 초대합니다</h2>
          <p class="greeting">
            {config.greeting.map((line) => (line ? <span>{line}</span> : <span class="gap" />))}
          </p>
        </div>

        <div class="family reveal">
          {
            [groom, bride].map((person) => (
              <p>
                <span class="parents">{person.father} · {person.mother}</span>
                <span class="of">의</span>
                <span class="relation">{person.relation}</span>
                <strong>{person.name}</strong>
              </p>
            ))
          }
        </div>

        <div class="contact reveal">
          {
            [
              { role: '신랑', person: groom },
              { role: '신부', person: bride },
            ].map(({ role, person }) => (
              <div class="contact-row">
                <span class="contact-who">{role}에게 연락하기</span>
                <a class="btn btn-ghost" href={telHref(person.phone)}>전화</a>
                <a class="btn btn-ghost" href={smsHref(person.phone)}>문자</a>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 밤에서 노을로 넘어가는 하늘 -->
      <div class="sky sky-down" aria-hidden="true"></div>

      <!-- 예식 일시 -->
      <section class="sand">
        <div class="reveal">
          <p class="latin eyebrow">The Day</p>
          <h2 class="title">예식 일시</h2>
          <p class="when">
            {dateLabel}<br />{timeLabel}
          </p>
        </div>

        <div class="calendar reveal" aria-label={`${date.year}년 ${date.month}월 달력`}>
          <p class="calendar-month latin">{date.year}. {pad(date.month)}</p>
          <div class="calendar-grid">
            {WEEKDAYS.map((d, i) => <span class:list={['dow', { sun: i === 0 }]}>{d}</span>)}
            {
              calendarCells.map((d, i) =>
                d === null ? (
                  <span />
                ) : (
                  <span class:list={['day', { sun: i % 7 === 0, the: d === date.day }]}>{d}</span>
                ),
              )
            }
          </div>
        </div>

        <p class="dday reveal" id="dday" data-date={isoDate}></p>
      </section>

      <!-- 사진첩: src/assets/gallery 폴더에 사진을 넣으면 채워집니다 -->
      <section class="sand">
        <div class="reveal">
          <p class="latin eyebrow">Gallery</p>
          <h2 class="title">우리의 사진첩</h2>
        </div>
        {
          galleryFiles.length > 0 ? (
            <>
              <div class="gallery reveal" id="gallery">
                {galleryFiles.map((src, i) => (
                  <button
                    class="gallery-item"
                    type="button"
                    data-full={galleryFull[i].src}
                    aria-label={`사진 ${i + 1} 크게 보기`}
                    hidden={i >= GALLERY_PREVIEW}
                  >
                    <Image src={src} alt="" width={420} height={420} fit="cover" format="webp" quality={75} loading="lazy" />
                  </button>
                ))}
              </div>
              {galleryFiles.length > GALLERY_PREVIEW && (
                <button class="btn btn-text gallery-more" id="gallery-more" type="button">
                  사진 더 보기 ({galleryFiles.length - GALLERY_PREVIEW}장)
                </button>
              )}
            </>
          ) : (
            <>
              <div class="gallery gallery-empty reveal" aria-hidden="true">
                {Array.from({ length: 6 }, () => <span class="gallery-item" />)}
              </div>
              <p class="note gallery-note reveal">사진을 준비하고 있습니다.</p>
            </>
          )
        }
      </section>

      <!-- 오시는 길 -->
      <section class="sand">
        <div class="reveal">
          <p class="latin eyebrow">Location</p>
          <h2 class="title">오시는 길</h2>
          <p class="venue-name">{venue.name} {venue.hall}</p>
          <p class="venue-address">{venue.address}</p>
          {venue.tel && <p class="venue-tel"><a href={telHref(venue.tel)}>{venue.tel}</a></p>}
        </div>

        {
          config.naverMapClientId && (
            <div
              class="map reveal"
              id="map"
              data-lat={venue.lat}
              data-lng={venue.lng}
              data-name={venue.name}
              role="img"
              aria-label={`${venue.name} 위치 지도`}
            />
          )
        }

        <div class="map-buttons reveal">
          {mapLinks.map((m) =>
            m.app ? (
              <a class="btn btn-line" href={m.href} data-app={m.app}>{m.label}</a>
            ) : (
              <a class="btn btn-line" href={m.href} target="_blank" rel="noopener">{m.label}</a>
            )
          )}
        </div>
        <button class="btn btn-text reveal" type="button" data-copy={venue.address} data-copied="주소를 복사했습니다">
          주소 복사하기
        </button>

        {
          venue.guides.length > 0 && (
            <dl class="guides reveal">
              {venue.guides.map((g) => (
                <div class="guide">
                  <dt>{g.title}</dt>
                  <dd>{g.lines.map((line) => <span>{line}</span>)}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </section>

      <!-- 마음 전하실 곳 -->
      <section class="sand">
        <div class="reveal">
          <p class="latin eyebrow">With Heart</p>
          <h2 class="title">마음 전하실 곳</h2>
          <p class="note">
            참석이 어려우신 분들을 위해<br />계좌번호를 함께 적어 둡니다.<br />너그러운 마음으로 양해 부탁드립니다.
          </p>
        </div>

        <div class="accounts reveal">
          {
            accountGroups.map((group) => (
              <details class="account-group">
                <summary>{group.label}</summary>
                <ul>
                  {group.list.map((a) => (
                    <li>
                      <div class="account-info">
                        <span class="account-owner">{a.role} {a.name}</span>
                        <span class="account-number">{a.bank} {a.number}</span>
                      </div>
                      <button
                        class="btn btn-small"
                        type="button"
                        data-copy={`${a.bank} ${a.number}`}
                        data-copied="계좌번호를 복사했습니다"
                      >
                        복사
                      </button>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>
      </section>

      <!-- 방명록 -->
      {
        config.guestbook.apiKey && (
          <section class="sand guestbook" id="guestbook">
            <div class="reveal">
              <p class="latin eyebrow">Guestbook</p>
              <h2 class="title">방명록</h2>
              <p class="note">두 사람에게 축하의 한마디를 남겨 주세요.</p>
            </div>

            <form class="gb-form reveal" id="gb-form" novalidate>
              <label class="sr-only" for="gb-name">이름</label>
              <input id="gb-name" name="name" type="text" maxlength="20" placeholder="이름" autocomplete="name" required />
              <label class="sr-only" for="gb-message">축하 메시지</label>
              <textarea id="gb-message" name="message" rows="4" maxlength="300" placeholder="축하 메시지" required />
              <div class="gb-form-foot">
                <span class="gb-count" id="gb-count" aria-hidden="true">0 / 300</span>
                <button class="btn btn-fill" type="submit">남기기</button>
              </div>
            </form>

            <p class="gb-status" id="gb-status" role="status">방명록을 불러오는 중입니다.</p>
            <ul class="gb-list" id="gb-list" />
            <button class="btn btn-text" id="gb-more" type="button" hidden>더 보기</button>
          </section>
        )
      }

      <!-- 다시 노을로 -->
      <div class="sky sky-up" aria-hidden="true"></div>

      <footer class="closing">
        <div class="reveal">
          <p class="closing-text">
            저무는 하루 끝에서도<br />늘 서로의 곁에 서 있겠습니다.
          </p>
          <p class="closing-names">{groom.name} · {bride.name}</p>
          <div class="share">
            {
              share.kakaoJsKey && (
                <button class="btn btn-ghost" type="button" id="kakao-share">
                  카카오톡으로 공유하기
                </button>
              )
            }
            <button class="btn btn-ghost" type="button" id="link-share">청첩장 링크 복사하기</button>
          </div>
        </div>
      </footer>
    </main>

    {
      galleryFiles.length > 0 && (
        <dialog class="lightbox" id="lightbox" aria-label="사진 크게 보기">
          <img alt="" />
          <button class="lb-btn lb-close" type="button" aria-label="닫기">✕</button>
          <button class="lb-btn lb-prev" type="button" aria-label="이전 사진">‹</button>
          <button class="lb-btn lb-next" type="button" aria-label="다음 사진">›</button>
          <p class="lb-count"></p>
        </dialog>
      )
    }

    {
      config.bgm && (
        <div class="bgm">
          <span class="bgm-hint" id="bgm-hint" aria-hidden="true">음악과 함께 보기</span>
          <button
            class="bgm-btn"
            id="bgm"
            type="button"
            aria-label="배경음악 재생"
            aria-pressed="false"
            data-src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${config.bgm}`}
          >
            <svg class="bgm-note" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                d="M9 17.5V5.8l10-2v11.4M9 17.5a2.6 2.6 0 1 1-2.6-2.6A2.6 2.6 0 0 1 9 17.5Zm10-2.3a2.6 2.6 0 1 1-2.6-2.6 2.6 2.6 0 0 1 2.6 2.6Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="bgm-bars" aria-hidden="true"><i /><i /><i /></span>
          </button>
        </div>
      )
    }

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
